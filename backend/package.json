{
  "name": "surexend-backend",
  "version": "1.0.0",
  "description": "SureXend Backend API",
  "scripts": {
    "build": "prisma generate && nest build",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "register:wallets": "node scripts/register-all-wallets.js",
    "ledger:report": "node scripts/ledger-drift-report.js",
    "ledger:baseline": "node scripts/backfill-ledger-baseline.js",
    "ledger:db": "node scripts/db-ledger-ops.js",
    "provider:preflight": "node scripts/provider-contract-preflight.js",
    "launch:gate": "node scripts/financial-launch-gate.js",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "db:rehearsal": "node scripts/postgres-rehearsal.js",
    "db:deploy": "node scripts/deploy-database.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "prestart": "npm run db:deploy",
    "prestart:prod": "npm run db:deploy"
  },
  "overrides": {
    "body-parser": "1.20.8",
    "multer": "$multer",
    "qs": "6.16.0",
    "glob": "13.0.6"
  },
  "dependencies": {
    "@circle-fin/adapter-circle-wallets": "^1.6.0",
    "@circle-fin/bridge-kit": "^1.13.0",
    "@google/generative-ai": "^0.14.0",
    "@nestjs/bull": "^10.1.1",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^10.0.0",
    "@nestjs/event-emitter": "^2.0.4",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/schedule": "^4.0.1",
    "@nestjs/throttler": "^5.1.1",
    "@prisma/client": "^5.16.1",
    "@simplewebauthn/server": "^11.0.0",
    "@types/bcryptjs": "^2.4.6",
    "axios": "^1.7.2",
    "bcryptjs": "^3.0.3",
    "bull": "^4.12.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.7.4",
    "date-fns": "^3.6.0",
    "firebase-admin": "^12.3.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "multer": "^2.4.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pdfkit": "^0.15.0",
    "pg": "^8.23.0",
    "prisma": "^5.16.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reflect-metadata": "^0.2.0",
    "resend": "^3.4.0",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.4",
    "speakeasy": "^2.0.0",
    "uuid": "^10.0.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "roots": [
      "<rootDir>/src/",
      "<rootDir>/test/"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@railway/cli": "^5.35.0",
    "@types/jest": "^29.5.2",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.10",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/pdfkit": "^0.13.5",
    "@types/qrcode": "^1.5.5",
    "@types/speakeasy": "^2.0.10",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.1.3"
  }
}
