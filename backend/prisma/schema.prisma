generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  phone            String    @unique
  passwordHash     String
  firstName        String
  lastName         String
  avatar           String?
  surexTag         String?   @unique
  pin              String?
  kycTier          Int       @default(0)
  kycStatus        KycStatus @default(UNVERIFIED)
  referralCode     String    @unique
  referredById     String?
  twoFactorSecret  String?
  twoFactorEnabled Boolean   @default(false)
  currencyDisplay  String    @default("NGN")
  defaultWallet    String    @default("AUTO")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  isActive         Boolean   @default(true)
  isBanned         Boolean   @default(false)
  role             String    @default("USER")
  fcmToken        String?

  wallet          Wallet?
  bankAccounts    BankAccount[]
  transactions    Transaction[]
  conversions     Conversion[]
  billPayments    BillPayment[]
  kycDocuments    KycDocument[]
  supportTickets  SupportTicket[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  referredUsers   Referral[]      @relation("ReferredUser")
  referralsMade   Referral[]      @relation("Referrer")
  referralRewards ReferralReward[]
  virtualAccounts VirtualAccount[]
  passkeys        Passkey[]

  @@index([email, phone])
}

model Passkey {
  id           String    @id @default(uuid())
  userId       String
  credentialId String    @unique
  publicKey    String
  counter      Int       @default(0)
  transports   String    @default("[]")
  deviceName   String    @default("")
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Wallet {
  id               String          @id @default(uuid())
  userId           String          @unique
  usdtBalance      Float           @default(0.0)
  usdcBalance      Float           @default(0.0)
  lockedBalance    Float           @default(0.0)
  localBalance     Float           @default(0.0) // NGN/GHS/KES balance
  localBalances    Json            @default("{}") // Per-currency local balances e.g. {"NGN":1000,"GHS":200}
  realLocalBalance Float           @default(0.0) // REAL local money (bank transfers / admin NGN credits) — only this pays bills & withdrawals
  pendingBalance   Float           @default(0.0) // Incoming deposits not yet confirmed
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  addresses        WalletAddress[]
}

model WalletAddress {
  id        String   @id @default(uuid())
  walletId  String
  network   String
  address   String
  createdAt DateTime @default(now())
  wallet    Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@unique([network, address])
}

model VirtualAccount {
  id            String   @id @default(uuid())
  userId        String
  provider      String   @default("FLUTTERWAVE")
  reference     String   @unique
  accountNumber String
  accountName   String
  bankName      String
  bankCode      String
  currency      String   @default("NGN")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum TransactionType {
  SEND
  RECEIVE
  CONVERT
  BILL_PAYMENT
  REFERRAL_EARNING
  WITHDRAWAL
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

model Transaction {
  id        String            @id @default(uuid())
  userId    String
  type      TransactionType
  status    TransactionStatus @default(PENDING)
  amount    Float
  fee       Float             @default(0.0)
  currency  String
  reference String            @unique
  metadata  Json?
  createdAt DateTime          @default(now())
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum ConversionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Conversion {
  id              String           @id @default(uuid())
  userId          String
  usdtAmount      Float
  fiatAmount      Float
  fiatCurrency    String
  rate            Float
  fee             Float
  status          ConversionStatus @default(PENDING)
  flutterwaveRef  String?
  bankAccountId   String?
  createdAt       DateTime         @default(now())
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BankAccount {
  id            String   @id @default(uuid())
  userId        String
  bankName      String
  bankCode      String
  accountNumber String
  accountName   String
  country       String
  currency      String
  isVerified    Boolean  @default(false)
  isDefault     Boolean  @default(false)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BillPayment {
  id         String            @id @default(uuid())
  userId     String
  type       String
  provider   String
  recipient  String
  amount     Float
  usdtAmount Float
  reference  String            @unique
  status     TransactionStatus @default(PENDING)
  metadata   Json?
  createdAt  DateTime          @default(now())
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Referral {
  id         String   @id @default(uuid())
  referrerId String
  referredId String   @unique
  earnings   Float    @default(0.0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  referrer   User     @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referred   User     @relation("ReferredUser", fields: [referredId], references: [id], onDelete: Cascade)
}

// A Circle Programmable Wallet owned by the platform, not by an end user.
// This lets an operator fund a clearly-labelled campaign wallet in Circle and
// trace every referral reward from the Circle console.
model PlatformWallet {
  id             String   @id @default(uuid())
  key            String   @unique
  label          String
  circleWalletId String?  @unique
  walletSetId    String?
  blockchain     String
  address        String?
  currency       String   @default("USDC")
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  referralRewards ReferralReward[]
}

// One immutable reward entitlement per customer and campaign. Funds are never
// booked to a customer at eligibility time: an approved payout is sent from
// the Circle campaign wallet, and Circle's inbound webhook books the receipt.
model ReferralReward {
  id                  String   @id @default(uuid())
  userId              String
  campaign            String
  requiredReferrals   Int      @default(5)
  referralCount       Int      @default(0)
  amount              Float    @default(5.0)
  currency            String   @default("USDT")
  status              String   @default("ELIGIBLE")
  platformWalletId    String?
  circleTransactionId String?  @unique
  reference           String   @unique
  approvedById        String?
  paidAt              DateTime?
  failureReason       String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platformWallet      PlatformWallet? @relation(fields: [platformWalletId], references: [id], onDelete: SetNull)

  @@unique([userId, campaign])
  @@index([status, createdAt])
  @@index([platformWalletId])
}

enum KycStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

model KycDocument {
  id              String    @id @default(uuid())
  userId          String
  tier            Int
  type            String
  documentUrl     String
  selfieUrl       String?
  status          KycStatus @default(PENDING)
  rejectionReason String?
  createdAt       DateTime  @default(now())
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SupportTicket {
  id        String           @id @default(uuid())
  userId    String
  subject   String
  category  String
  status    String           @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  SupportMessage[]
}

enum RoleType {
  USER
  AI
  HUMAN
}

model SupportMessage {
  id        String        @id @default(uuid())
  ticketId  String
  role      RoleType      @default(USER)
  content   String
  createdAt DateTime      @default(now())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  body      String
  type      String
  isRead    Boolean  @default(false)
  data      Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OtpCode {
  id         String   @id @default(uuid())
  identifier String   // email or phone
  code       String
  type       String   // REGISTER, LOGIN, PASSWORD_RESET
  expiresAt  DateTime
  used       Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model RateCache {
  id        String   @id @default(uuid())
  currency  String   @unique
  rate      Float
  updatedAt DateTime @updatedAt
}

model FeeConfig {
  id         String @id @default(uuid())
  type       String @unique
  percentage Float  @default(0.0)
  flatAmount Float  @default(0.0)
  minAmount  Float  @default(0.0)
  maxAmount  Float?
}

// Replay protection for money-moving endpoints. The client sends a UUID as an
// `Idempotency-Key` header; the first response is stored here and replayed for
// any retry carrying the same key, so a double-tap can only ever charge once.
model IdempotencyRecord {
  id        String   @id @default(uuid())
  userId    String
  scope     String
  key       String
  response  Json
  createdAt DateTime @default(now())

  @@unique([userId, scope, key])
  @@index([createdAt])
}

// Admin-controlled pricing overrides for billed services (Smartspeed).
// - data: planCode = Smartspeed dataplan_id. A row with empty planCode is the
//   network-wide auto margin %; a row with a planCode and sellPrice is a
//   per-plan override. Sell price = override ?? cost * (1 + margin/100) ?? cost.
// - airtime: planCode always empty; marginPct is the markup added on top of the
//   face value the user enters. Sell price = face * (1 + margin/100).
model LedgerEntry {
  id         String   @id @default(uuid())
  transferId String
  account    String
  currency   String
  amountMinor BigInt
  reference  String?
  kind       String
  createdAt  DateTime @default(now())

  @@unique([transferId, account, currency])
  @@index([account, currency])
  @@index([reference])
  @@index([kind, createdAt])
}

model ServicePricing {
  id        String   @id @default(uuid())
  category  String   // 'data' | 'airtime'
  provider  String   // MTN | GLO | AIRTEL | 9MOBILE
  planCode  String   @default("")
  costPrice Float?   // data: provider cost (info only; refreshed from catalog)
  sellPrice Float?   // data: admin override for this plan
  marginPct Float?   // data: network auto-margin; airtime: markup on face value
  disabled  Boolean  @default(false) // admin turned this plan off
  updatedAt DateTime @default(now())
  @@unique([category, provider, planCode])
}
