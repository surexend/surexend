# Database
DATABASE_URL=postgresql://user:password@localhost:5432/surexend

# Redis. Production must use a managed, non-local Redis URL; it is the shared
# source for rate limits, PIN lockouts, WebAuthn challenges, and refresh sessions.
REDIS_URL=redis://localhost:6379

# Testing mode: enables the default transaction PIN (0000) for users without a
# custom PIN. The backend REFUSES TO START if this is 'true' while NODE_ENV is
# 'production'. Remove it entirely before launch.
TESTING_ENABLED=true
DEFAULT_PIN=0000

# JWT — required. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The backend refuses to boot without both of these. Never commit real values.
JWT_SECRET=super-secret-jwt-key
JWT_REFRESH_SECRET=super-secret-jwt-refresh-key

# Webhook signature verification. On by default; every enabled inbound webhook
# is verified before it can move money. PaymentPoint/VtPass remain closed until
# their provider callback authentication contracts are independently verified.
# Set to 'false' ONLY to replay a captured payload against a local dev database.
WEBHOOK_REQUIRE_SIGNATURE=true
# Explicit provider scope. Flutterwave is removed unless FLUTTERWAVE_ENABLED=true.
ENABLED_PROVIDERS=circle,paymentpoint,smartspeed

# PaymentPoint (https://paymentpoint.co) — Nigerian Virtual Accounts (replacing Flutterwave)
PAYMENTPOINT_API_KEY=
PAYMENTPOINT_SECRET_KEY=
PAYMENTPOINT_BUSINESS_ID=
PAYMENTPOINT_WEBHOOK_SECRET=
# Keep disabled until PaymentPoint's callback authentication contract is confirmed
# against provider documentation or an authenticated captured webhook. Accepted
# values: static-secret-legacy, hmac-sha256-raw-base64, hmac-sha256-raw-hex.
PAYMENTPOINT_WEBHOOK_SIGNATURE_MODE=disabled
# Accepted values: paymentpoint-signature, x-paymentpoint-signature, verif-hash.
PAYMENTPOINT_WEBHOOK_SIGNATURE_HEADER=disabled
# Required only if the webhook is later enabled after provider-contract review.
# PAYMENTPOINT_WEBHOOK_CONTRACT_EVIDENCE_ID=provider-doc-or-captured-webhook-packet
PAYMENTPOINT_WEBHOOK_ENABLED=false
# Optional: a provider-documented GET endpoint used only for a read-only preflight.
# PAYMENTPOINT_READ_ONLY_PREFLIGHT_URL=

# Flutterwave (https://flutterwave.com) — optional legacy fallback; leave disabled for PaymentPoint.
FLUTTERWAVE_ENABLED=false
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# VTPass (https://vtpass.com)
# VTPASS_WEBHOOK_SECRET: shared secret checked against the x-vtpass-signature
# header. Leave it empty and /webhooks/vtpass stays closed (returns 503) — it is
# not the live bill provider any more, Smartspeed is.
VTPASS_API_KEY=
VTPASS_PUBLIC_KEY=
VTPASS_SECRET_KEY=
VTPASS_BASE_URL=https://sandbox.vtpass.com/api
VTPASS_WEBHOOK_SECRET=
VTPASS_WEBHOOK_ENABLED=false

# Smartspeed Telecom VTU (https://smartspeedtelecom.com) — live airtime & data
SMARTSPEED_API_TOKEN=
SMARTSPEED_BASE_URL=https://www.smartspeedtelecom.com/api

# Yellow Card (https://yellowcard.io)
YELLOW_CARD_API_KEY=
YELLOW_CARD_SECRET=

# Tatum (https://tatum.io)
TATUM_API_KEY=
TATUM_WEBHOOK_HMAC_SECRET=

# Smile Identity (https://smileidentity.com)
SMILE_PARTNER_ID=
SMILE_API_KEY=

# Gemini AI (https://aistudio.google.com)
GEMINI_API_KEY=

# Firebase Admin
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# Email via Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@surexend.com

# SMS via Termii
TERMII_API_KEY=

# Circle Web3 Services (Developer-Controlled Wallets)
# https://developers.circle.com/api-reference/keys — keys are PREFIX:ID:SECRET.
#   Staging/testnet : TEST_API_KEY:<id>:<secret>
#   Production/main : LIVE_API_KEY:<id>:<secret>
# One key per environment; the backend classifies the prefix strictly and
# refuses any other shape. The entity secret is the 64-hex value registered in
# the Circle Console (same secret backs every wallet set in the account).
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
# Mainnet money movement requires a pre-created, custody-reviewed application
# wallet set. This set must not be reused for referral rewards.
CIRCLE_WALLET_SET_ID=
# Mainnet referral rewards require a separately controlled, pre-created Circle
# wallet set. Leave blank on testnet if the controlled test flow creates one.
CIRCLE_REFERRAL_REWARD_WALLET_SET_ID=
CIRCLE_WEBHOOK_SECRET=
# Five-referrals campaign: Circle wallet is funded with USDC, then operations
# provisions USDT on this Circle-supported blockchain before payouts. Never use
# a placeholder contract address in production; leave blank to keep payouts off.
# CIRCLE_REFERRAL_REWARD_BLOCKCHAIN=ETH
# CIRCLE_REFERRAL_REWARD_USDT_TOKEN_ADDRESS=
# Mainnet must use a pre-created custody-reviewed wallet set; automatic
# wallet-set creation is disabled in mainnet mode.
# CIRCLE_WALLET_SET_ID=mainnet-wallet-set-id

# Auth cookies are HttpOnly and are set by the backend. In production the
# frontend, WebAuthn origin, and backend must all use HTTPS.

# App
PORT=3001
FRONTEND_URL=https://surexend.com
NODE_ENV=development
# Production must explicitly opt in after all financial gates and live tests pass.
# Keep false for read-only testnet/demo deployments.
MONEY_MOVEMENT_ENABLED=false

# Ledger read cutover (see docs/rollout-status.md step 3).
# false = balance reads use the legacy float columns (current production
# behavior). true = reads come from the double-entry LedgerEntry table, with a
# per-currency fallback to the float for currencies that have no ledger rows.
# Run scripts/backfill-ledger-baseline.js BEFORE enabling, then npm run
# ledger:report must be clean. Mainnet must stay false until cutover is done.
LEDGER_READS_ENABLED=false

# Database circuit breaker and compliance/limits. A migration seeds all
# FinancialControl switches false. Enabling them requires a pending request and
# approval by a distinct stepped-up admin; pausing is immediate.
# REQUIRE_KYC_FOR_MONEY_MOVEMENT=true
# SANCTIONS_BLOCKED_ADDRESSES=0x...
# MAX_DAILY_CRYPTO_SEND_USD=1000
# MAX_DAILY_CONVERSION_USD=1000
# MAX_DAILY_BILL_NGN=500000
# Mainnet first launch should keep CANARY_MODE=true and list only controlled
# verified users. Disable it only after a signed staged-canary evidence packet.
# CANARY_MODE=true
# CANARY_USER_IDS=user-id-1,user-id-2
# STAGED_CANARY_EVIDENCE_ID=canary-observation-window

# Network environment — see docs/mainnet-config.md for the full Production
# procedure. Staging stays testnet. Production mainnet requires ALL of the
# values below; the backend refuses to boot on any mixed configuration, and the
# first boot stamps the database with its chain environment so a database
# stamped testnet can never be booted as mainnet (or vice versa).
# CHAIN_ENV=testnet                      # 'testnet' (default) | 'mainnet'
# MAINNET_ENABLED=false
# MAINNET_CONFIG_APPROVED=false          # true only with the reviewed matrix below
# MAINNET_DB_ISOLATION_CONFIRMED=false   # true only when Production has its OWN clean database
# MAINNET_ENABLED_NETWORKS=ARC
# Official Arc mainnet values (docs.arc.io + Circle Wallets/Bridge Kit):
# MAINNET_CHAIN_MATRIX_JSON='{"ARC":{"circleBlockchain":"ARC","cctpChain":"Arc","rpcUrls":["https://rpc.mainnet.arc.io"],"chainId":5042,"usdcContract":"0x3600000000000000000000000000000000000000","usdcDecimals":6,"explorerUrl":"https://explorer.arc.io"}}'
# Testnet-only overrides (ignored on mainnet, where the matrix is authoritative):
# ARC_RPC_URL=https://rpc.testnet.arc.network
# ARC_CHAIN_ID=5042002
# ARC_USDC_CONTRACT_ADDRESS=0x3600000000000000000000000000000000000000

# DB ops runner (scripts/db-ledger-ops.js) — optional, used outside the app for
# ledger baseline/report. Never commit a real value.
# SXDB_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Ledger drift ALERTING. The hourly reconciliation already persists every
# mismatch as an AuditLog row (action=LEDGER_DRIFT). The alert watcher runs
# every 15 min and alerts on NEW rows only. With no destination configured it
# still emits an error-level log (ship logs -> alert on "Ledger drift").
# LEDGER_DRIFT_ALERTS_ENABLED=true      # default true; set false to silence
# LEDGER_DRIFT_WEBHOOK_URL=https://hooks.example.com/your-alert-endpoint
# LEDGER_DRIFT_ALERT_EMAIL=ops@surexend.com   # sent via Resend (RESEND_API_KEY)

# Release evidence gates. These do not enable money movement; they identify the
# reviewed packet when an operator runs scripts/financial-launch-gate.js.
# FINANCIAL_RELEASE_APPROVED=true       # production/mainnet only after approval
# FINANCIAL_RELEASE_APPROVED_BY=ops-team-or-reviewer
# FINANCIAL_RELEASE_TICKET=change-ticket
# FINANCIAL_RELEASE_EVIDENCE_ID=immutable-release-packet-id
# SMARTSPEED_CONTRACT_EVIDENCE_ID=provider-contract-and-sandbox-receipt-id
# CIRCLE_CCTP_CONTRACT_EVIDENCE_ID=cctp-contract-and-replay-status-evidence-id
# POSTGRES_REHEARSAL_EVIDENCE_ID=postgres-rehearsal-evidence-id
# TESTNET_E2E_EVIDENCE_ID=testnet-receipt-table-evidence-id
# ALERT_RESTART_EVIDENCE_ID=alert-restart-drill-evidence-id
# PROVIDER_PREFLIGHT_EVIDENCE_FILE=./release-evidence/provider-preflight.json
# LAUNCH_GATE_EVIDENCE_FILE=./release-evidence/launch-gate.json
# POSTGRES_TEST_DATABASE_URL=postgresql://...  # dedicated concurrency rehearsal DB only
# POSTGRES_REHEARSAL_SSL=false                 # local embedded PostgreSQL only
# POSTGRES_REHEARSAL_EVIDENCE_FILE=./release-evidence/postgres-rehearsal.json
# POSTGRES_MIGRATION_REHEARSAL_DATABASE_URL=postgresql://...  # isolated source DB only
# POSTGRES_MIGRATION_REHEARSAL_RESTORE_DATABASE_URL=postgresql://... # separate isolated restore DB
# POSTGRES_MIGRATION_REHEARSAL_SSL=false       # local embedded PostgreSQL only
# POSTGRES_MIGRATION_REHEARSAL_EVIDENCE_FILE=./release-evidence/postgres-migration-rehearsal.json
# PG_DUMP_BIN=/usr/bin/pg_dump                 # required for backup/restore evidence
# PG_RESTORE_BIN=/usr/bin/pg_restore           # required for backup/restore evidence
# The rehearsal refuses production-looking URLs, dumps the isolated source,
# records its SHA-256, restores into the separate target, and verifies the
# financial schema plus fail-closed control state. The dump is deleted after the
# checksum is retained in the evidence artifact.
# KYC_AML_EVIDENCE_ID=approved-compliance-packet
# SANCTIONS_PROVIDER_EVIDENCE_ID=screening-provider-test-packet
# CUSTODY_DUAL_CONTROL_EVIDENCE_ID=segregated-custody-drill
# INDEPENDENT_SECURITY_REVIEW_EVIDENCE_ID=external-review-report
# DISASTER_RECOVERY_EVIDENCE_ID=backup-restore-and-failover-drill
